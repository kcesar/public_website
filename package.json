{
  "name": "kcesar-2024-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "if command -v bun >/dev/null 2>&1; then bun test tests/unit; else echo 'bun not found; skipping unit tests (they run in PR checks)'; fi",
    "test:e2e": "playwright test",
    "gen:contours": "node tools/topo/gen-contours.mjs",
    "gen:terrain": "node tools/topo/gen-terrain.mjs",
    "gen:topo": "bun run gen:contours && bun run gen:terrain"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.12",
    "jsonp": "^0.2.1",
    "next": "^16.2.12",
    "postcss-100vh-fix": "^1.0.2",
    "react": "^19.2.8",
    "react-countup": "^6.5.0",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/jsonp": "^0.2.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "daisyui": "^5.7.14",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
